{
  "name": "flightbrief",
  "productName": "FlightBrief",
  "version": "1.3.3",
  "description": "Briefing de vol, logbook, suivi de carrière et tracking de vol en direct (SimConnect) pour les créateurs de contenu simu aérienne, avec source OBS intégrée.",
  "main": "main.js",
  "author": "FlightBrief",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LLCenLive/FlightBrief.git"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "electron-icon-builder --input=./build/icon.png --output=./build --flatten",
    "predist": "node scripts/check-build.js",
    "dist": "electron-builder",
    "predist:win": "node scripts/check-build.js",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "multicast-dns": "^7.2.5",
    "node-forge": "^1.4.0",
    "node-simconnect": "^4.2.0"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-icon-builder": "^2.0.1"
  },
  "build": {
    "appId": "com.flightbrief.app",
    "productName": "FlightBrief",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "tracker.js",
      "mobile-tls.js",
      "renderer/**/*",
      "build/icon.png",
      "build/icon.ico",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "FlightBrief-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FlightBrief",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "publish": null
  }
}
